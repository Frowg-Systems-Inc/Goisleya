<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Isley.VoiceServer</AssemblyName>
    <RootNamespace>Isley.VoiceServer</RootNamespace>
    <Title>Isley Voice Server</Title>
    <AssemblyTitle>Isley Voice Server</AssemblyTitle>
    <Description>Local signaling host bundled with Isley for private push-to-talk proximity voice.</Description>
    <Version>1.3.6</Version>
    <AssemblyVersion>1.3.6.0</AssemblyVersion>
    <FileVersion>1.3.6.0</FileVersion>
    <InformationalVersion>1.3.6</InformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);.codex-build\**;**\.codex-build\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
