<Window x:Class="Isley.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Isley"
        Title="Isley - Live Minimap"
        Width="472"
        Height="560"
        MinWidth="320"
        MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseUp="Window_PreviewMouseUp"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseLeave="Window_MouseLeave"
        Deactivated="Window_Deactivated"
        SizeChanged="Window_SizeChanged">
    <Border x:Name="Shell"
            Margin="6"
            Padding="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#8038BDF8"
            BorderThickness="1"
        CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect x:Name="ShellShadowEffect"
                              BlurRadius="30" ShadowDepth="5" Opacity="0.72" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="44" />
                <RowDefinition x:Name="ContentRow" Height="*" />
                <RowDefinition x:Name="FooterRow" Height="32" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragHeader"
                  Grid.Row="0"
                  Background="Transparent"
                  MouseEnter="NativeChrome_MouseEnter"
                  MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34"
                        Background="{StaticResource BrandSurfaceBrush}"
                        BorderBrush="{StaticResource BrandBorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <local:TriceratopsLogo Width="29" Height="29"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel x:Name="BrandStatusPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrandNameText"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="ISLEY" />
                    <StackPanel x:Name="HeaderStatusRail" Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="ConnectionStatusDot"
                                 Width="6" Height="6" Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="ConnectionStatusText"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="STARTING MAP" />
                        <Border Width="1" Height="10" Margin="8,0" Background="#5064748B" />
                        <Ellipse x:Name="GameStatusDot"
                                 Width="6" Height="6" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Fill="#FF64748B" />
                         <TextBlock x:Name="GameStatusText"
                                    FontSize="9" FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="GAME OFFLINE" />
                        <Border Width="1" Height="10" Margin="8,0" Background="#5064748B" />
                        <Ellipse x:Name="ServerStatusDot"
                                 Width="6" Height="6" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Fill="#FF64748B" />
                        <TextBlock x:Name="ServerStatusText"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="SERVER ..." />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpacityButton" Style="{StaticResource ChromeButton}"
                            FontSize="9" ToolTip="Cycle overlay opacity"
                            Click="OpacityButton_Click" Content="92" />
                    <Button x:Name="SizeButton" Style="{StaticResource ChromeButton}"
                            FontSize="12" ToolTip="Toggle compact and expanded sizes"
                            Click="SizeButton_Click" Content="SIZE" />
                    <Button x:Name="LockButton" Style="{StaticResource ChromeButton}"
                            ToolTip="Lock Isley in place"
                            AutomationProperties.Name="Lock Isley position"
                            AutomationProperties.HelpText="Makes the overlay ignore all pointer input except this unlock button"
                            Click="LockButton_Click">
                        <TextBlock x:Name="LockGlyphText"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="&#xE785;" />
                    </Button>
                    <Button x:Name="DockButton" Style="{StaticResource ChromeButton}"
                            FontSize="13" ToolTip="Collapse Isley to a small draggable status rail"
                            Click="DockButton_Click" Content="—" />
                    <Button Style="{StaticResource ChromeButton}"
                            ToolTip="Close Isley"
                            Click="CloseButton_Click" Content="X" />
                </StackPanel>
            </Grid>

            <Border x:Name="MapViewportBorder"
                    Grid.Row="1"
                    Margin="0,7,0,0"
                    Background="#FF070B10"
                    BorderBrush="#5564748B"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="12">
                <Grid>
                     <wv2:WebView2CompositionControl x:Name="LiveMapWebView"
                                                     HorizontalAlignment="Stretch"
                                                     MouseLeave="LiveMapWebView_MouseLeave"
                                                     LostKeyboardFocus="LiveMapWebView_LostKeyboardFocus"
                                                     VerticalAlignment="Stretch"
                                                     UseLayoutRounding="False" />

                    <Border x:Name="MapLightOverlay"
                            Background="#FF02070D"
                            IsHitTestVisible="False"
                            Opacity="0" />

                    <Border x:Name="UniversalSessionSurface"
                            Panel.ZIndex="45"
                            Background="#FC070B10"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid Margin="18">
                            <ScrollViewer x:Name="UniversalSessionScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="VerticalOnly"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center">
                            <StackPanel MaxWidth="310" Margin="0,36,0,12"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Border Width="46" Height="46" HorizontalAlignment="Center"
                                        Background="{StaticResource BrandSurfaceBrush}"
                                        BorderBrush="{StaticResource BrandBorderBrush}"
                                        BorderThickness="1" CornerRadius="14">
                                    <local:TriceratopsLogo Width="39" Height="39"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,13,0,0" HorizontalAlignment="Center"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#FF67E8F9" Text="UNIVERSAL SESSION" />
                                <TextBlock x:Name="UniversalSessionTitleText" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="OFFICIAL SERVER" />
                                <Border Height="1" Margin="24,11" Background="#5538BDF8" />
                                <TextBlock x:Name="UniversalSessionDetailText"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="9" FontWeight="SemiBold" LineHeight="14"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="All-server tools are ready. Server-fed live positions are unavailable in this mode." />
                                 <Grid x:Name="UniversalCoordinatePanel" Margin="0,11,0,8">
                                     <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Height="1" Margin="18,0,18,9" Background="#5538BDF8" />
                                    <Grid Grid.Row="1">
                                        <TextBlock FontSize="8" FontWeight="Bold"
                                                   Foreground="#FF67E8F9" Text="YOUR POSITION · PLAYER SYNC" />
                                        <TextBlock x:Name="UniversalCoordinateStatusText"
                                                   HorizontalAlignment="Right" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="OFF · CLIPBOARD UNTOUCHED" />
                                    </Grid>
                                    <TextBlock x:Name="UniversalCoordinatePositionText" Grid.Row="2"
                                               Margin="0,4,0,0" HorizontalAlignment="Center"
                                               FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="X —   Y —   Z —" />
                                    <TextBlock x:Name="UniversalCoordinateMotionText" Grid.Row="3"
                                               Margin="0,3,0,0" HorizontalAlignment="Center"
                                               FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="1 TURN SYNC ON · 2 TAB → ASSET LOCATION IN GAME" />
                                    <TextBlock x:Name="UniversalCoordinateHillText" Grid.Row="4"
                                               Margin="0,3,0,0" HorizontalAlignment="Center"
                                               FontSize="8" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="#FFFBBF24"
                                               ToolTip="Two-capture geometry only. Hill sliding, slowdown, surface traction, and passability must be verified in game."
                                               Text="HILL CHECK · COPY TWO POINTS AFTER MOVING" />
                                    <TextBlock x:Name="UniversalCoordinateAdviceText" Grid.Row="5"
                                               Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               FontSize="7" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="Isley uses only two player-triggered coordinate copies." />
                                    <UniformGrid Grid.Row="6" Columns="2" Margin="-2,7,-2,0">
                                        <Button x:Name="UniversalCoordinateCaptureButton"
                                                Style="{StaticResource DrawerCompactButton}"
                                                AutomationProperties.Name="Toggle Player Sync coordinate capture"
                                                AutomationProperties.HelpText="Reads only valid Asset Location copies while The Isle or Isley is active"
                                                ToolTip="Enable coordinate-only Player Sync while The Isle or Isley is active"
                                                Click="UniversalCoordinateCaptureButton_Click"
                                                Content="PLAYER SYNC ON" />
                                        <Button x:Name="UniversalCoordinateClearButton"
                                                Style="{StaticResource DrawerCompactButton}"
                                                AutomationProperties.Name="Clear Terrain Probe session evidence"
                                                ToolTip="Clear session-only captured coordinates without changing the capture preference"
                                                Click="UniversalCoordinateClearButton_Click"
                                                Content="CLEAR" IsEnabled="False" />
                                    </UniformGrid>
                                </Grid>
                                <Border x:Name="ServerRestartUniversalPanel"
                                        Margin="0,2,0,5" Padding="8,7" CornerRadius="8"
                                        Background="#70B45309" BorderBrush="#99FBBF24"
                                        BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontSize="8" FontWeight="Bold"
                                                       Foreground="#FFFBBF24" Text="SERVER RESTART WATCH" />
                                            <TextBlock x:Name="ServerRestartUniversalStatusText"
                                                       HorizontalAlignment="Right" FontSize="8" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Text="10:00" />
                                        </Grid>
                                        <TextBlock x:Name="ServerRestartUniversalDetailText" Margin="0,3,0,0"
                                                   FontSize="7" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="Player-reported warning · verify in game." />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SafeLogoutUniversalPanel"
                                        Margin="0,2,0,5" Padding="8,7" CornerRadius="8"
                                        Background="#70212C38" BorderBrush="#8058D68D"
                                        BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontSize="8" FontWeight="Bold"
                                                       Foreground="#FF6EE7B7" Text="SAFE LOGOUT GUARD" />
                                            <TextBlock x:Name="SafeLogoutUniversalStatusText"
                                                       HorizontalAlignment="Right" FontSize="8" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Text="READY" />
                                        </Grid>
                                        <TextBlock x:Name="SafeLogoutUniversalDetailText" Margin="0,3,0,0"
                                                   FontSize="7" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="Manual countdown only on this session." />
                                    </StackPanel>
                                </Border>
                                <UniformGrid Columns="2" Margin="-2,13,-2,0">
                                    <Button Style="{StaticResource DrawerButton}" Height="34"
                                            ToolTip="Open the species Field Guide and Combat Brief"
                                            Click="UniversalSessionGuideButton_Click" Content="OPEN GUIDE" />
                                    <Button Style="{StaticResource DrawerButton}" Height="34"
                                            ToolTip="Open the current dinosaur Life Run"
                                            Click="UniversalSessionLifeRunButton_Click" Content="OPEN LIFE RUN" />
                                </UniformGrid>
                                <UniformGrid Columns="4" Margin="-2,0,-2,0">
                                    <Button x:Name="UniversalSessionSightingButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Report a session-only relative sighting without claiming live detection"
                                            Click="UniversalSessionSightingButton_Click" Content="SIGHT" />
                                    <Button x:Name="UniversalSessionVitalsButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Report current health, food, water, and stamina bands"
                                            Click="UniversalSessionVitalsButton_Click" Content="VITALS" />
                                    <Button x:Name="UniversalSessionFieldConditionsButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Report current weather and light for this server session"
                                            Click="UniversalSessionFieldConditionsButton_Click" Content="FIELD" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Open survival and session timers"
                                            Click="UniversalSessionTimersButton_Click" Content="TIMERS" />
                                    <Button x:Name="UniversalSessionRestartButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Report or review an in-game server restart warning"
                                            Click="RestartWatchOpenButton_Click" Content="RESTART" />
                                    <Button x:Name="SafeLogoutUniversalButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Start or restart the session-only Safe Logout Guard"
                                            Click="SafeLogoutStartButton_Click" Content="LOGOUT" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Open push-to-talk key and provider status"
                                            Click="UniversalSessionVoiceButton_Click" Content="VOICE" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Choose another session server"
                                            Click="UniversalSessionAppButton_Click" Content="SERVER" />
                                </UniformGrid>
                                <UniformGrid Columns="4" Margin="-2,0,-2,0">
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Run the current trip-readiness check"
                                            Click="UniversalSessionTripButton_Click" Content="TRIP" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Open the species-aware fight check"
                                            Click="UniversalSessionFightButton_Click" Content="FIGHT" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Open the current dinosaur Growth Clock"
                                            Click="UniversalSessionGrowthButton_Click" Content="GROW" />
                                    <Button Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Open the current dinosaur Nest Planner"
                                            Click="UniversalSessionNestButton_Click" Content="NEST" />
                                </UniformGrid>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="7" Foreground="#FF70899A"
                                           Text="NO SERVER-FED POSITIONS · CAPTURE IS OPT-IN, COORDINATE-ONLY, SESSION-ONLY, AND NEVER READS GAME MEMORY" />
                            </StackPanel>
                            </ScrollViewer>
                            <Button Width="58" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource MapChipButton}"
                                    ToolTip="Open server and overlay settings"
                                    Click="UniversalSessionAppButton_Click" Content="TOOLS" />
                        </Grid>
                    </Border>

                     <Border x:Name="StreamerMask"
                            Panel.ZIndex="55"
                            Background="#F8070B10"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" HorizontalAlignment="Center"
                                    Background="{StaticResource BrandSurfaceBrush}"
                                    BorderBrush="{StaticResource BrandBorderBrush}"
                                    BorderThickness="1" CornerRadius="14">
                                <local:TriceratopsLogo Width="41" Height="41"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="STREAMER MODE" />
                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="LIVE POSITIONS AND IDENTITIES ARE HIDDEN" />
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="9" Padding="9,6"
                            Background="{StaticResource MapChromeBrush}"
                            BorderBrush="#8064748B" BorderThickness="1" CornerRadius="9"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FreshnessStatusDot" Width="7" Height="7"
                                         Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{StaticResource WarningBrush}" />
                                <TextBlock x:Name="MapFreshnessText" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Text="SYNCING" />
                                <Border Width="1" Height="11" Margin="7,0" Background="#6664748B" />
                                <TextBlock x:Name="AnimalCountText" VerticalAlignment="Center"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           ToolTip="Blue is you, green is a friend, amber is another authorized player"
                                           Text="YOU ONLY" />
                            </StackPanel>
                            <TextBlock x:Name="LiveHealthText"
                                       Margin="13,3,0,0"
                                       FontSize="7.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Live health map relay voice"
                                       Text="MAP · — · NET · OFF · VOICE · OFF" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MeasurementPanel"
                            MaxWidth="190" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="9,45,9,9" Padding="9,7"
                            Background="{StaticResource MapChromeBrush}"
                            BorderBrush="#AA22D3EE" BorderThickness="1" CornerRadius="9"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="MeasurementHeadingText" FontSize="8" FontWeight="Bold"
                                       Foreground="#FF67E8F9" Text="MAP RULER" />
                            <TextBlock x:Name="MeasurementValueText" Margin="0,2,0,0"
                                       FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource PrimaryTextBrush}" Text="SELECT START" />
                            <TextBlock x:Name="MeasurementDetailText" Margin="0,2,0,0"
                                       FontSize="8" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="CLICK ANY POINT" />
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="9" Orientation="Horizontal"
                                MouseEnter="NativeChrome_MouseEnter">
                        <Button x:Name="PlayerSyncMapButton" Width="58" Margin="0,0,5,0" Padding="0"
                                Style="{StaticResource MapChipButton}"
                                AutomationProperties.Name="Toggle Player Sync"
                                AutomationProperties.HelpText="Turns clipboard Asset Location capture on or off for your map marker"
                                ToolTip="Player Sync places your icon from in-game Asset Location copies"
                                Click="TerrainProbeToggleButton_Click"
                                Content="SYNC ON" />
                        <Button x:Name="RecenterButton" Width="96" Margin="0,0,5,0"
                                Style="{StaticResource MapChipButton}"
                                ToolTip="Find your marker, or resume follow after dragging"
                                Click="RecenterButton_Click" Content="FIND ME" />
                        <Button x:Name="QuickZoomOutButton" Width="32" Margin="0,0,5,0" Padding="0"
                                Style="{StaticResource MapChipButton}" FontSize="15"
                                ToolTip="Zoom out" Click="ZoomOutButton_Click" Content="-" />
                        <Button x:Name="QuickZoomInButton" Width="32" Margin="0,0,5,0" Padding="0"
                                Style="{StaticResource MapChipButton}" FontSize="14"
                                ToolTip="Zoom in" Click="ZoomInButton_Click" Content="+" />
                        <Button x:Name="ToolsButton" Width="54" Padding="0"
                                Style="{StaticResource MapChipButton}"
                                ToolTip="Open map and overlay tools"
                                Click="ToolsButton_Click" Content="TOOLS" />
                    </StackPanel>

                    <Border x:Name="NavigationReadoutPanel"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="9" Padding="9,7"
                            Background="{StaticResource MapChromeBrush}"
                            BorderBrush="#8064748B" BorderThickness="1" CornerRadius="9"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="PositionText" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}" Text="POSITION WAITING" />
                            <Grid x:Name="CompassRibbon" Width="190" Height="19" Margin="0,4,0,0"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompassLeftText" VerticalAlignment="Center"
                                           FontSize="8" FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="--" />
                                <TextBlock x:Name="HeadingText" Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="Bold" TextAlignment="Center"
                                           Foreground="#FF7DD3FC" Text="HEADING --" />
                                <TextBlock x:Name="CompassRightText" Grid.Column="2" VerticalAlignment="Center"
                                           FontSize="8" FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" Text="--" />
                                <Ellipse x:Name="CompassCourseMarker" Grid.ColumnSpan="3"
                                         Width="6" Height="6" Margin="0,0,0,1"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                         Fill="#FFFF8A65" Stroke="#FF090D13" StrokeThickness="1"
                                         Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="MovementText" Margin="0,2,0,0"
                                       FontSize="8" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="SPEED --" />
                            <Border x:Name="NearestPlacePanel" Margin="0,6,0,0" Padding="0,6,0,0"
                                    BorderBrush="#5567E8F9" BorderThickness="0,1,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock FontSize="8" FontWeight="Bold"
                                               Foreground="#FF67E8F9" Text="NEAREST MAP PLACE" />
                                    <TextBlock x:Name="NearestPlaceText" MaxWidth="220" Margin="0,2,0,0"
                                               FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PrimaryTextBrush}" Text="WAITING" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="TacticalIntelStack"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9">
                        <Border x:Name="EncounterAwarenessPanel"
                                Width="184" Margin="0,0,0,6" Padding="9,7"
                                Background="{StaticResource MapChromeBrush}"
                                BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="9"
                                IsHitTestVisible="True" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EncounterHeadingText" FontSize="8" FontWeight="Bold"
                                               Foreground="#FFFBBF24" Text="ENCOUNTER AWARENESS" />
                                    <TextBlock x:Name="EncounterPrimaryText" Margin="0,2,0,0"
                                               FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PrimaryTextBrush}" Text="WAITING" />
                                    <TextBlock x:Name="EncounterDetailText" Margin="0,2,0,0"
                                               FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}" Text="WAITING" />
                                    <Button x:Name="EncounterEscapeButton"
                                            Width="104" Height="22" Margin="0,5,0,0" Padding="7,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource MapChipButton}"
                                            FontSize="7" Background="#D94A2412" BorderBrush="#AAF59E0B"
                                            ToolTip="Create a 75 MU route away from the latest live authorized contact while avoiding saved Danger zones and traced no-go areas"
                                            Click="EncounterEscapeButton_Click"
                                            Content="ESCAPE ROUTE" Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="EncounterDirectionBadge" Grid.Column="1"
                                        Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#261F2937" BorderBrush="#99FBBF24" BorderThickness="1"
                                        CornerRadius="13" Visibility="Collapsed">
