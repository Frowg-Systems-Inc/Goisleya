                                                                       Foreground="{StaticResource WarningBrush}" Text="ABORT WHEN" />
                                                            <TextBlock x:Name="GuideCombatAbortText" FontSize="8" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                                            <Border x:Name="FightCheckAnchor" Margin="0,8,0,0" Padding="0,7,0,0"
                                                                    BorderBrush="#44556A7A" BorderThickness="0,1,0,0">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <TextBlock FontSize="7" FontWeight="Bold"
                                                                                   Foreground="#FF67E8F9" Text="FIGHT CHECK" />
                                                                        <TextBlock x:Name="FightCheckBadgeText" HorizontalAlignment="Right"
                                                                                   FontSize="7" FontWeight="Bold"
                                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    </Grid>
                                                                    <TextBlock x:Name="FightCheckHeadingText" Margin="0,4,0,0"
                                                                               FontSize="9" FontWeight="Bold" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                                    <TextBlock x:Name="FightCheckDetailText" Margin="0,2,0,0"
                                                                               FontSize="8" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    <Button x:Name="FightCheckActionButton" Margin="0,6,0,0"
                                                                            Style="{StaticResource DrawerCompactButton}"
                                                                            Click="FightCheckActionButton_Click" Content="REPORT VITALS" />
                                                                    <TextBlock Margin="0,3,0,0" FontSize="7" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Text="Manual vitals + authorized map context · never predicts a winner or a safe fight" />
                                                                </StackPanel>
                                                            </Border>
                                                            <UniformGrid Columns="2" Margin="-2,7,-2,0">
                                                                <Button x:Name="GuideCombatMutationsButton"
                                                                        Style="{StaticResource DrawerCompactButton}"
                                                                        ToolTip="Search the current mutation catalog for this combat style"
                                                                        Click="GuideCombatMutationsButton_Click" Content="COMBAT MUTATIONS" />
                                                                <Button x:Name="GuideCombatTriageButton"
                                                                        Style="{StaticResource DrawerCompactButton}"
                                                                        ToolTip="Open damage and status recovery guidance"
                                                                        Click="GuideCombatTriageButton_Click" Content="DAMAGE TRIAGE" />
                                                            </UniformGrid>
                                                            <Button Style="{StaticResource DrawerCompactButton}" Margin="0,1,0,0"
                                                                    ToolTip="Open the current community combat and damage guide"
                                                                    Click="OpenCombatGuideButton_Click" Content="CURRENT COMBAT GUIDE" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="7" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Text="Positioning brief, not a damage calculator · balance and server rules can differ" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Margin="0,7,0,2" FontSize="7" FontWeight="Bold"
                                                               Foreground="{StaticResource SecondaryTextBrush}" Text="FOOD SNAPSHOT" />
                                                    <TextBlock x:Name="GuideSpeciesFoodText" FontSize="8" TextWrapping="Wrap"
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <UniformGrid Columns="2" Margin="-2,7,-2,0">
                                                        <Button x:Name="GuideDietCoachButton" Style="{StaticResource DrawerCompactButton}"
                                                                ToolTip="Use this species in the active life run's diet coach"
                                                                Click="GuideDietCoachButton_Click" Content="USE IN DIET" />
                                                        <Button Style="{StaticResource DrawerCompactButton}"
                                                                ToolTip="Open the current community species reference"
                                                                Click="OpenFieldGuideButton_Click" Content="CURRENT GUIDE" />
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="ESSENTIAL CONTROLS" />
                                            <StackPanel x:Name="GuideControlsPanel" />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="CURRENT REFERENCES" />
                                            <UniformGrid Columns="2" Margin="-2,0,-2,2">
                                                <Button Style="{StaticResource DrawerCompactButton}"
                                                        Click="OpenControlsGuideButton_Click" Content="CONTROLS" />
                                                <Button Style="{StaticResource DrawerCompactButton}"
                                                        Click="OpenGrowthGuideButton_Click" Content="GROWTH" />
                                                <Button Style="{StaticResource DrawerCompactButton}"
                                                        Click="OpenNestingGuideButton_Click" Content="NESTING" />
                                                <Button Style="{StaticResource DrawerCompactButton}"
                                                        Click="OpenZonesGuideButton_Click" Content="ZONES" />
                                            </UniformGrid>
                                            <TextBlock Margin="2,5,2,0" FontSize="7" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="Public 21-playable snapshot / combat 0.21.734 / server and Hordetest rosters can differ" />
                                        </StackPanel>

                                        <StackPanel x:Name="HubToolsPanel" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="ISLEY UPDATES" />
                                            <Button x:Name="AutomaticUpdatesButton"
                                                    Style="{StaticResource DrawerButton}"
                                                    ToolTip="Automatically check Isley's trusted stable release channel and notify you before installing"
                                                    AutomationProperties.Name="Toggle automatic Isley update checks"
                                                    AutomationProperties.HelpText="Checks the trusted Isley release channel in the background; installation only starts when you choose Update and Restart"
                                                    Click="AutomaticUpdatesButton_Click"
                                                    Content="Automatic updates · On" />
                                            <Button x:Name="CheckForIsleyUpdateButton"
                                                    Style="{StaticResource DrawerButton}"
                                                    ToolTip="Check the trusted Isley stable release channel now"
                                                    Click="CheckForIsleyUpdateButton_Click"
                                                    Content="Check for updates" />
                                            <Button x:Name="WhatsNewButton"
                                                    Style="{StaticResource DrawerButton}"
                                                    ToolTip="Show bundled release notes for this Isley build"
                                                    Click="WhatsNewButton_Click"
                                                    Content="What's new" />
                                            <Button x:Name="PreferBetaUpdatesButton"
                                                    Style="{StaticResource DrawerButton}"
                                                    ToolTip="Opt into the beta release channel when published (stable remains default and trusted)"
                                                    Click="PreferBetaUpdatesButton_Click"
                                                    Content="Beta channel · Off" />
                                            <TextBlock x:Name="IsleyUpdateStatusText" Margin="2,-2,2,3"
                                                       FontSize="8" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="v1.3.0 · Automatic checks on · You choose when to restart" />
                                            <TextBlock x:Name="WhatsNewStatusText" Margin="2,-2,2,3"
                                                       FontSize="7" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="Open What's new for this build's highlights." />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="ISLEY COMPANION" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenCurrentDinoButton_Click" Content="Core vitals" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenQuestsButton_Click" Content="Life Run" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenBattlepassButton_Click" Content="Growth Clock" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    ToolTip="Open Isley's local route and destination tools"
                                                    Click="OpenTeleportsButton_Click" Content="Routes and destinations" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenKillfeedButton_Click" Content="Animal sighting check" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenLeaderboardButton_Click" Content="Trip readiness" />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="BUILD &amp; CONDITIONS" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenGarageButton_Click" Content="Dinosaur and life setup" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenDinoShopButton_Click" Content="Mutation planner" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenSkinShopButton_Click" Content="Field conditions" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenSkinEditorButton_Click" Content="Map light and visibility" />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="DECISION TOOLS" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenCasinoButton_Click" Content="Fight check" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenCasesButton_Click" Content="Resource finder" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenBetsButton_Click" Content="Next move" />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="QUICK ACCESS" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenPlayerGuideButton_Click" Content="Life guide" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenFullMapButton_Click" Content="Reload Live Map" />
                                            <Button Style="{StaticResource DrawerButton}"
                                                    Click="OpenHubButton_Click" Content="Open Isley tools" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="LoadingOverlay" Background="#F8070B10" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,11,0,0" HorizontalAlignment="Center"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="CONNECTING TO LIVE MAP" />
                            <TextBlock x:Name="LoadingDetailText" Width="280" Margin="0,6,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Opening Isley Live Map and syncing current layers..." />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="OnboardingTutorialLayer"
                          Panel.ZIndex="90"
                          Margin="0"
                          Background="#E8070B10"
                          Visibility="Collapsed"
                          AutomationProperties.Name="Isley quick start tutorial">
                        <Border x:Name="OnboardingTutorialCard"
                                MaxWidth="390"
                                Margin="12"
                                Padding="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FC0A0F16"
                                BorderBrush="#CC38BDF8"
                                BorderThickness="1"
                                CornerRadius="12"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle"
                                Focusable="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="Black"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="WELCOME TO ISLEY" />
                                        <TextBlock x:Name="OnboardingStepKickerText"
                                                   Margin="0,2,0,0"
                                                   FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="SERVER COMPATIBILITY" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Width="28" Height="28" Padding="0"
                                            Style="{StaticResource ChromeButton}"
                                            ToolTip="Skip and close the quick start"
                                            AutomationProperties.Name="Skip and close tutorial"
                                            Click="OnboardingCloseButton_Click"
                                            Content="X" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,12,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="OnboardingProgressBar"
                                                 Height="4"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Minimum="0" Maximum="5" Value="1"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#55334152" />
                                    <TextBlock x:Name="OnboardingProgressText"
                                               Grid.Column="1"
                                               FontSize="8" FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="1 OF 5" />
                                </Grid>

                                <ScrollViewer x:Name="OnboardingScrollViewer"
                                              Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly">
                                    <StackPanel Margin="0,2,4,8">
                                        <TextBlock x:Name="OnboardingTitleText"
                                                   FontSize="18" FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="Choose where you are playing" />
                                        <TextBlock x:Name="OnboardingBodyText"
                                                   Margin="0,10,0,0"
                                                   FontSize="11" LineHeight="17"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="Live Map mode uses Isley's bundled independent map. Official and Any Server keep the same companion tools ready without server setup." />
                                        <StackPanel x:Name="OnboardingServerChoicePanel"
                                                    Margin="0,13,0,0">
                                            <TextBlock FontSize="8" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="SELECT YOUR SERVER MODE" />
                                            <UniformGrid Columns="3" Margin="-2,5,-2,0">
                                                <Button x:Name="OnboardingServerLiveMapButton"
                                                        Tag="live-map"
                                                        Style="{StaticResource DrawerCompactButton}"
                                                        ToolTip="Bundled independent Isley map"
                                                        AutomationProperties.Name="Select Live Map mode"
                                                        Click="ServerSessionProfileButton_Click"
                                                        Content="LIVE MAP" />
                                                <Button x:Name="OnboardingServerOfficialButton"
                                                        Tag="official"
                                                        Style="{StaticResource DrawerCompactButton}"
                                                        ToolTip="Any official The Isle server"
                                                        AutomationProperties.Name="Select Official server mode"
                                                        Click="ServerSessionProfileButton_Click"
                                                        Content="OFFICIAL" />
                                                <Button x:Name="OnboardingServerAnyButton"
                                                        Tag="community"
                                                        Style="{StaticResource DrawerCompactButton}"
                                                        ToolTip="Any community, private, passworded, or unlisted server"
                                                        AutomationProperties.Name="Select Any Server mode"
                                                        Click="ServerSessionProfileButton_Click"
                                                        Content="ANY" />
                                            </UniformGrid>
                                            <TextBlock x:Name="OnboardingServerModeStatusText"
                                                       Margin="1,5,1,0"
                                                       FontSize="7.5" FontWeight="Bold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="LIVE MAP · BUNDLED ISLEY MAP AVAILABLE" />
                                            <TextBlock Margin="1,7,1,0"
                                                       FontSize="7.5" LineHeight="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       AutomationProperties.Name="Onboarding independent map disclosure"
                                                       Text="Isley's map stays independent and uses an attributed public Gateway feed. A participating server may optionally provide an Isley join link for its own authorized continuous telemetry." />
                                        </StackPanel>
                                        <Border Margin="0,14,0,0"
                                                Padding="10,8"
                                                Background="#B31A2430"
                                                BorderBrush="#8064748B"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontSize="8" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="GOOD TO KNOW" />
                                                <TextBlock x:Name="OnboardingTipText"
                                                           Margin="0,4,0,0"
                                                           FontSize="9" LineHeight="14"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="Private and unlisted servers need no setup for the map and manual tools. Continuous live data needs that server's optional Isley join link." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <UniformGrid Grid.Row="3" Columns="3" Margin="-2,8,-2,-2">
                                    <Button x:Name="OnboardingSkipButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Skip the quick start; it can be replayed from App"
                                            AutomationProperties.Name="Skip tutorial"
                                            Click="OnboardingSkipButton_Click"
                                            Content="SKIP" />
                                    <Button x:Name="OnboardingBackButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Go to the previous tutorial step"
                                            AutomationProperties.Name="Previous tutorial step"
                                            Click="OnboardingBackButton_Click"
                                            Content="BACK" />
                                    <Button x:Name="OnboardingNextButton"
                                            Style="{StaticResource DrawerCompactButton}"
                                            ToolTip="Go to the next tutorial step"
                                            AutomationProperties.Name="Next tutorial step"
                                            Click="OnboardingNextButton_Click"
                                            Content="NEXT" />
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="FooterGrid" Grid.Row="2" Margin="0,5,0,0"
                  MouseEnter="NativeChrome_MouseEnter">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="FooterSizeColumn" Width="70" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ClickThroughButton" Padding="9,4" FontSize="9"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTip="Toggle whether mouse clicks pass through to the game"
                        Click="ClickThroughButton_Click" Content="INTERACT" />

                <Button x:Name="StatusBeaconButton" Grid.Column="1" Margin="3,0,0,0" Padding="7,3"
                        MinWidth="132" Height="24" FontSize="7.5" FontWeight="Bold"
                        Background="#401A2430" BorderBrush="#8067E8F9" BorderThickness="1"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        ToolTip="Manual health, food, water, and stamina bands; click to report"
                        Click="StatusBeaconButton_Click" Content="HP ? · F ? · W ? · ST ?" />

                <Button x:Name="SurvivalQuickButton" Grid.Column="2" Margin="3,0,0,0" Padding="7,3"
                        MinWidth="90" Height="24" FontSize="7" FontWeight="Bold"
                        Background="#70A83B12" BorderBrush="#B8FFA36C" BorderThickness="1"
                        Foreground="#FFFFD7C2"
                        AutomationProperties.Name="Report the in-game Vomit sickness warning and start five-minute recovery guidance"
                        ToolTip="Use only while the game shows Vomit sickness; click once or press Ctrl+Shift+S to start the five-minute working estimate"
                        Click="SurvivalQuickButton_Click" Content="VOMIT WARNING? START 5M" />

                <TextBlock x:Name="InteractionStatusText" Grid.Column="3" Margin="8,0,2,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextAlignment="Right" FontSize="8" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           ToolTip="Global shortcuts for interaction, visibility, recentering, Danger marking, quick timers, Death marking, and command search"
                           Text="I CLICK · O SHOW · R CENTER · D ALERT · B BODY · T 5M · P FIND" />

                <Grid x:Name="FooterSizeHost" Grid.Column="4" MinWidth="32" Height="28">
                    <TextBlock x:Name="WindowSizeText" Margin="0,0,28,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="8" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="472x560" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               FontSize="14" Foreground="#AA38BDF8"
                               IsHitTestVisible="False" Text="//" />
                    <Thumb x:Name="ResizeGrip" Width="28" Height="28"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Background="Transparent" Cursor="SizeNWSE"
                           ToolTip="Drag to resize the overlay"
                           AutomationProperties.Name="Resize Isley overlay"
                           DragDelta="ResizeGrip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
