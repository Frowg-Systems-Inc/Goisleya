<Window x:Class="Isley.IsleyDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Isley"
        Title="Isley Dock"
        Width="362" Height="64"
        MinWidth="264" MinHeight="64"
        MaxWidth="362" MaxHeight="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True">
    <Border Margin="3" Padding="7,4" CornerRadius="11"
            Background="#F2080D14" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{StaticResource BrandSurfaceBrush}"
                    BorderBrush="{StaticResource BrandBorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <local:TriceratopsLogo Width="30" Height="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="11" FontWeight="Black" Foreground="#FFF4F7FB" Text="ISLEY" />
                <TextBlock Margin="0,1,0,0" FontSize="7" FontWeight="Bold"
                           Foreground="#FF58D68D" Text="LIVE DOCK" />
            </StackPanel>
            <Button x:Name="DockVitalsButton" Grid.Column="2" Height="38" Margin="2,0,5,0"
                    Padding="7,3" VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                    Background="#B3101822" BorderBrush="#807E8995" BorderThickness="1"
                    Click="VitalsButton_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DockVitalsSourceText"
                               FontSize="6.5" FontWeight="Bold" Foreground="#FF8FA2B4"
                               TextTrimming="CharacterEllipsis" Text="WAITING / REPORT" />
                    <TextBlock x:Name="DockVitalValuesText" Grid.Row="1" Margin="0,2,0,0"
                               FontSize="7.3" FontWeight="Black" Foreground="#FFF4F7FB"
                               TextTrimming="CharacterEllipsis" Text="HP?  F?  W?  ST?" />
                </Grid>
            </Button>
            <Button Grid.Column="3" Height="28" Margin="1,0" VerticalAlignment="Center"
                    Padding="0"
                    Background="#FF17212D" BorderBrush="#8058D68D" BorderThickness="1"
                    Foreground="#FFF4F7FB" FontSize="9" FontWeight="Bold"
                    ToolTip="Restore the full Isley overlay"
                    Click="OpenButton_Click" Content="OPEN" />
            <Button x:Name="DockLockButton" Grid.Column="4" Width="28" Height="28"
                    Margin="1,0" Padding="0" VerticalAlignment="Center"
                    Background="#FF17212D" BorderBrush="#8058D68D" BorderThickness="1"
                    Foreground="#FFF4F7FB"
                    ToolTip="Lock Isley dock in place"
                    AutomationProperties.Name="Lock Isley dock position"
                    AutomationProperties.HelpText="Makes the dock ignore all pointer input except this unlock button"
                    Click="LockButton_Click">
                <TextBlock x:Name="DockLockGlyphText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="&#xE785;" />
            </Button>
            <Button Grid.Column="5" Height="28" Margin="3,0,0,0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#FFF4F7FB" FontSize="12" FontWeight="Bold"
                    ToolTip="Close Isley"
                    Click="CloseButton_Click" Content="X" />
        </Grid>
    </Border>
</Window>
