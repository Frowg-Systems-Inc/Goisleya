<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Isley.Updater</AssemblyName>
    <RootNamespace>Isley.Updater</RootNamespace>
    <Title>Isley Updater</Title>
    <AssemblyTitle>Isley Updater</AssemblyTitle>
    <Description>Safe staged updater for Isley. Verifies a staged package path, preserves IsleyData, and relaunches Isley.exe after replace.</Description>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
